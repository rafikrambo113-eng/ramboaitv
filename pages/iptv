        st.markdown(f"**الدولة:** {ch['country']}")
        st.markdown(f"**التصنيف:** {', '.join(ch['categories']) or 'عام'}")

        m3u = f"#EXTM3U\n#EXTINF:-1,{ch['name']}\n{ch['url']}\n"
