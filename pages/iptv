ARAB_COUNTRIES = ['EG','SA','AE','KW','QA','BH','OM','JO','LB','SY','IQ','LY','TN','DZ','MA','SD','YE','PS','MR','SO','DJ','KM']

@st.cache_data(ttl=3600)
def load_channels():
    try:
        channels_res = requests.get('https://iptv-org.github.io/api/channels.json', timeout=15)
        channels = channels_res.json()

        streams_res = requests.get('https://iptv-org.github.io/api/streams.json', timeout=15)
        streams = streams_res.json()

        stream_map = {}
        for s in streams:
            if s.get('channel') and s.get('url') and s['channel'] not in stream_map:
                stream_map[s['channel']] = s['url']

        arabic = []
        for ch in channels:
            is_arabic = (
                ('ara' in (ch.get('languages') or [])) or
                (ch.get('country') in ARAB_COUNTRIES)
            )
            if is_arabic and ch['id'] in stream_map:
                arabic.append({
                    'id': ch['id'],
                    'name': ch.get('name', ''),
                    'country': ch.get('country', ''),
                    'categories': ch.get('categories') or [],
                    'logo': ch.get('logo', ''),
                    'url': stream_map[ch['id']]
                })

        return arabic
    except Exception as e:
        st.error(f"فشل التحميل: {e}")
        return []

# ---- HEADER ----
st.markdown("<h1 style='text-align:center'>📺 مشغل القنوات العربية</h1>", unsafe_allow_html=True)
