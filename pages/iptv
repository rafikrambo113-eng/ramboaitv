# ---- LOAD ----
with st.spinner("جاري تحميل القنوات..."):
    channels = load_channels()

if not channels:
    st.error("مفيش قنوات — تأكد من الاتصال بالنت")
    st.stop()

# ---- LAYOUT ----
col_list, col_player = st.columns([1, 2])

with col_list:
    st.markdown(f"**{len(channels)} قناة عربية شغالة**")

    search = st.text_input("🔍 ابحث عن قناة", placeholder="مثلاً: MBC، الجزيرة...")

    all_cats = ['الكل']
    for ch in channels:
        for c in ch['categories']:
            if c not in all_cats:
                all_cats.append(c)
    cat = st.selectbox("التصنيف", all_cats)

    filtered = [
        ch for ch in channels
        if (not search or search.lower() in ch['name'].lower())
        and (cat == 'الكل' or cat in ch['categories'])
    ]

    st.markdown(f"<small style='color:#666680'>{len(filtered)} نتيجة</small>", unsafe_allow_html=True)

    if 'selected' not in st.session_state:
        st.session_state.selected = None

    for ch in filtered[:80]:
        label = f"{ch['name']}  —  {ch['country']}  {('· ' + ch['categories'][0]) if ch['categories'] else ''}"
        if st.button(label, key=ch['id']):
            st.session_state.selected = ch

with col_player:
    if st.session_state.selected:
        ch = st.session_state.selected
